<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="module_category_auditors" model="ir.module.category">
        <field name="name">Auditors</field>
        <field name="description">Registro de Auditores Externos</field>
        <field name="sequence">2</field>
    </record>

    <record id="res_groups_privilege_auditors" model="res.groups.privilege">
        <field name="name">Auditors</field>
        <field name="category_id" ref="module_category_auditors" />
    </record>

    <record id="group_user" model="res.groups">
        <field name="name">User</field>
        <field name="user_ids" eval="[(4, ref('base.user_root'))]" />
        <field name="privilege_id" ref="res_groups_privilege_auditors" />
    </record>

    <record id="group_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="user_ids" eval="[(4, ref('base.user_root'))]" />
        <field name="privilege_id" ref="res_groups_privilege_auditors" />
        <field
            name="implied_ids"
            eval="[(4,ref('group_user')),(4,ref('base.group_partner_manager'))]"
        />
    </record>
</odoo>
